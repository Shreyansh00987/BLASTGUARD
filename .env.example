# ============================================================
# BLASTGUARD CONFIGURATION (.env)
# ============================================================

# Application Environment
ENVIRONMENT=demo
PROJECT_NAME=BlastGuard
VERSION=1.0.0

# FalkorDB Connection Settings
# When running with Docker Compose, FALKORDB_HOST is 'falkordb'
# When running locally, FALKORDB_HOST is 'localhost'
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=blastguard_cloud_graph

# Optional AI LLM API Keys (Falls back to deterministic graph reasoning if omitted)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Frontend Public API URL (Client-Side)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
